# PART 2 — DOWNSTREAM PATHWAY ENRICHMENT ANALYSIS (FSEA)
# ══════════════════════════════════════════════════════════════════

library(msigdbr)

# 1. Fetch Hallmark pathways from MSigDB
pathway_df <- msigdbr(species = "Homo sapiens", collection = "H")

# 2. Get model genes and clean up the suffix (e.g., "A1BG_Transcriptomics" -> "A1BG")
mofa_genes_raw <- features_names(MOFAobject)$Transcriptomics
mofa_genes_clean <- sub("_Transcriptomics$", "", mofa_genes_raw)

# 3. Temporarily assign clean gene names to the model so run_enrichment matches them
MOFAobject_clean <- MOFAobject
features_names(MOFAobject_clean)$Transcriptomics <- mofa_genes_clean

# 4. Filter pathway data to match your clean gene names
pathway_df_filtered <- pathway_df[pathway_df$gene_symbol %in% mofa_genes_clean, ]

# 5. Build the binary membership matrix (Pathways x Features)
feature_matrix <- table(pathway_df_filtered$gs_name, pathway_df_filtered$gene_symbol)
class(feature_matrix) <- "matrix"
feature_matrix[feature_matrix > 1] <- 1

# 6. Run enrichment analysis successfully
enrichment_res <- run_enrichment(
    MOFAobject_clean, 
    view = "Transcriptomics", 
    feature.sets = feature_matrix,
    statistical.test = "parametric"
)

# 7. Plot your results for your professor
plot_enrichment_heatmap(enrichment_res, factors = 2, max.pathways = 15)
plot_enrichment_heatmap(enrichment_res, factors = 3, max.pathways = 15)
