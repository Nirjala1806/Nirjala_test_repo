# Data options
# scale_views = TRUE scales all omics layers to the same variance
# This is important because your layers have very different value ranges
# e.g. transcriptomics values are very different from CNV values
data_opts <- get_default_data_options(MOFAobject)
data_opts$scale_views <- TRUE

# Model options
# num_factors = 15 latent factors to learn
# MOFA will automatically drop factors that explain no variance
model_opts <- get_default_model_options(MOFAobject)
model_opts$num_factors <- 15L

# Training options
# convergence_mode = "slow" gives the most accurate results
# seed = 42 makes results reproducible
# maxiter = 1000 maximum number of training iterations
train_opts <- get_default_training_options(MOFAobject)
train_opts$convergence_mode <- "slow"
train_opts$seed <- 42L
train_opts$maxiter <- 1000L
train_opts$outfile <- "UCEC_MOFA2.hdf5"


# Prepare the MOFA object with all options defined above
MOFAobject <- prepare_mofa(
  MOFAobject,
  data_options     = data_opts,
  model_options    = model_opts,
  training_options = train_opts
)

