# Helper function to load each omics layer
# MOFA2 requires features as ROWS and samples as COLUMNS
# This is the opposite of PCA where samples were rows
load_omics <- function(filepath, layer_name, skip_rows = 0) {
  
  # Load the CSV file
  df <- read.csv(filepath, row.names = 1,
                 check.names = FALSE, skip = skip_rows)
  
  # Keep only numeric columns
  # MOFA2 cannot handle text columns
  df <- df[, sapply(df, is.numeric), drop = FALSE]
  
  # Remove features with more than 50% missing values
  # Features missing in more than half the samples are unreliable
  missing_rate <- colMeans(is.na(df))
  df <- df[, missing_rate < 0.50, drop = FALSE]
  
  # Remove completely empty features
  # These have no data at all and cannot be used
  df <- df[, colSums(!is.na(df)) > 0, drop = FALSE]
  
  # Transpose so features are rows and samples are columns
  # MOFA2 requires this exact orientation
  df <- t(df)
  
  message(layer_name, ": ", nrow(df), " features x ", ncol(df), " samples")
  
  return(df)
}

# Load all 7 omics layers
# skip_rows = 2 for phosphoproteomics and acetylproteomics
# because those files have two extra header rows
omics_list <- list(
  Transcriptomics   = load_omics("transcriptomics.xls",   "Transcriptomics"),
  Proteomics        = load_omics("proteomics.xls",        "Proteomics"),
  Phosphoproteomics = load_omics("phosphoproteomics.xls", "Phosphoproteomics", skip_rows = 2),
  miRNA             = load_omics("miRNA.xls",             "miRNA"),
  CNV               = load_omics("CNV.xls",               "CNV"),
  Acetylproteomics  = load_omics("acetylproteomics.xls",  "Acetylproteomics",  skip_rows = 2),
  circular_RNA      = load_omics("circular_RNA.xls",      "circular_RNA")
)

# Find samples that are present in ALL 7 omics layers simultaneously
# Each layer has a different number of samples so we find the common set
common_samples <- Reduce(intersect, lapply(omics_list, colnames))
message("Common samples across all 7 layers: ", length(common_samples))

# Subset every layer to only the common samples in the same order
# MOFA2 requires all views to have exactly the same samples
omics_list <- lapply(omics_list, function(x) {
  x[, common_samples, drop = FALSE]
})

# Confirm all layers now have the same dimensions
message("Dimensions after alignment:")
lapply(omics_list, dim)

# Load clinical data
clinical <- read.csv("clinical.xls", row.names = 1)

# Replace empty strings with NA in tumor stage column
clinical$tumor_Stage.Pathological[clinical$tumor_Stage.Pathological == ""] <- NA

# Replace empty strings with NA in histological type column
clinical$Histologic_type[clinical$Histologic_type == ""] <- NA

# MOFA2 requires a column called 'sample' with the sample IDs
# This is how MOFA2 matches metadata to samples in the model
clinical$sample <- rownames(clinical)

# Subset clinical to only the common samples
clinical <- clinical[clinical$sample %in% common_samples, ]

message("Clinical data: ", nrow(clinical), " samples")
print(table(clinical$tumor_Stage.Pathological, useNA = "always"))
